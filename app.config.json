{
  "name": "jev-mcp",
  "tenantId": "TENANT_ID",
  "workloadAccountId": "WORKLOAD_ACCOUNT_ID",
  "environment": "prod",
  "region": "us-east-1",
  "terraform": {
    "stateBucket": "TERRAFORM_STATE_BUCKET",
    "stateRegion": "us-east-1",
    "statePrefix": "tenants/TENANT_ID/apps",
    "stateRoleArn": "STATE_ROLE_ARN"
  },
  "lambdas": ["mcp"],
  "frontend": {
    "buildCommand": "false",
    "distDir": "dist/frontend"
  },
  "esbuild": {
    "target": "node20",
    "external": ["aws-sdk", "aws-lambda"]
  }
}
